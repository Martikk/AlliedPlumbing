{
  "name": "allied",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.17 <=22"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "node src/scripts/generate-posts-index.mjs && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node src/scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "generate-sitemap": "node src/scripts/generate-sitemap.mjs",
    "gen:posts": "node src/scripts/generate-posts-index.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "test": "node --test tests/*.test.mjs",
    "check:head": "node src/scripts/check-head.mjs",
    "check:domains": "node src/scripts/check-domains.mjs",
    "check:backend": "node src/scripts/check-backend.mjs",
    "test:production": "node src/scripts/check-production.mjs && node src/scripts/check-backend.mjs",
    "deploy:backend": "node src/scripts/deploy-backend.mjs",
    "lighthouse": "npx --yes @lhci/cli@0.14.x autorun"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.3",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "sitemap": "^8.0.2",
    "tailwindcss": "^3.4.13",
    "typescript": "~5.9.3",
    "vite": "^5.4.10",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
