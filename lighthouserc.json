{
  "_comment": "Audit B-08 — the performance budget. These are the four baseline URLs from B-00. The budget is what the audit sets as the target state, so it keeps the Sprint 1-3 gains from being given back when content is added. Resource budgets are TRANSFER bytes (what Lighthouse measures), not the unzipped source.",
  "ci": {
    "collect": {
      "staticDistDir": "dist",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/index.html",
        "http://localhost/services/hvac/index.html",
        "http://localhost/projects/ridgeview/index.html",
        "http://localhost/quote/index.html"
      ],
      "settings": {
        "preset": "desktop",
        "emulatedFormFactor": "mobile",
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.95 }],

        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }],

        "resource-summary:script:size": ["error", { "maxNumericValue": 153600 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 61440 }],

        "uses-responsive-images": "warn",
        "modern-image-formats": "warn",
        "unused-javascript": "off",
        "unsized-images": "error",
        "tap-targets": "error",
        "color-contrast": "error",
        "heading-order": "error",
        "label": "error",
        "link-name": "error",
        "meta-description": "error",
        "document-title": "error",
        "html-has-lang": "error",
        "is-crawlable": "off"
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
